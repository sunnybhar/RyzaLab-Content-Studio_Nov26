# Copy to .env.local; never commit credential values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_ENCRYPTION_KEY=
STUDIO_APP_URL=http://localhost:3005
# Generate a separate random worker token; keep it on the server/worker only.
STUDIO_WORKER_TOKEN=
STUDIO_ALLOW_PROVIDER_EXECUTION=false
# Qualified server-owned pricing JSON. No defaults or guessed rates are provided.
STUDIO_RATE_CARD=
# Optional Google Docs connector (Google sign-in itself is configured in Supabase).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional transactional email adapter: Resend, verified sender required. No SMTP.
EMAIL_API_KEY=
EMAIL_FROM=
# Add research/text/image/video/audio provider credentials in Studio AI settings;
# these are encrypted with STUDIO_ENCRYPTION_KEY and never returned to clients.
