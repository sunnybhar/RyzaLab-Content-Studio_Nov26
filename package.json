    "jspdf": "^4.2.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.1",
