import {build}from'esbuild';import{chromium}from'playwright';import assert from'node:assert/strict';import{initialState,DEMO_ACTOR,EMPTY_MEDIA}from'../lib/studio/seed';import{applyCommand}from'../lib/studio/engine';import{copyIdentity}from'../lib/studio/solo-quality';
let s=initialState(DEMO_ACTOR,true);s=applyCommand(s,DEMO_ACTOR,{type:'policy.adoptSolo',expectedRuleVersion:s.settings.protectedVersion,packageCap:50,monthlyCap:500,requireIndependentReview:false,autoDraft:false,autoReview:true,autoCorrect:true},{demo:true});s.contents=s.contents.slice(0,1);s.packages=[];const c=s.contents[0];c.state='review';c.text='A household handoff can document useful routines and contacts.';c.metadata='';c.format='Text post';c.media=structuredClone(EMPTY_MEDIA);c.copyAcceptances=[];c.reviewSubmission={id:'root',actor:DEMO_ACTOR.email,at:new Date().toISOString(),identity:copyIdentity(c,s)};c.reviewCycle={rootSubmissionId:'root',rounds:1,jobId:'correction',status:'correcting',at:new Date().toISOString()};s.jobs=[{id:'correction',kind:'text',contentId:c.id,state:'queued',createdBy:DEMO_ACTOR.email}as any];const checking=structuredClone(s);checking.contents[0].reviewCycle!.status='reviewing';checking.contents[0].automaticReview={acceptanceId:'root',jobId:'recheck',at:new Date().toISOString()};checking.jobs=[{id:'recheck',kind:'review',contentId:c.id,state:'queued',createdBy:DEMO_ACTOR.email}as any];const ready=structuredClone(checking);ready.jobs=[];ready.contents[0].reviewCycle!.status='ready';ready.contents[0].agentReview={identity:copyIdentity(ready.contents[0],ready),jobId:'recheck',summary:'No remaining findings for this exact revision.',issues:[],provider:'openai',model:'fixture',independent:false,at:new Date().toISOString(),context:'provided_references'};
const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{SoloReview}from'./components/solo-review';const stages=${JSON.stringify([s,checking,ready])};window.calls=[];function App(){const[index,setIndex]=useState(0);const state=stages[index];return <><button onClick={()=>setIndex(i=>Math.min(i+1,2))}>Advance fixture</button><SoloReview key={index} content={state.contents[0]} state={state} actor={${JSON.stringify(DEMO_ACTOR)}} send={async c=>{window.calls.push(c)}} renderAsset={()=>null} requestChanges={()=>{}} openDraft={()=>{}} recordPriceException={()=>{}} refresh={async()=>{}} demo={true}/></>};createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,loader:{'.css':'empty'},format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true,args:['--no-sandbox']});try{const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('http://localhost:31342/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31342/');await page.getByText('AI correcting draft · round 1/2',{exact:true}).waitFor();assert.ok(await page.getByRole('button',{name:'Approve & publish',exact:true}).isDisabled());await page.getByRole('button',{name:'Advance fixture',exact:true}).click();await page.getByText('AI review queued…',{exact:true}).waitFor();await page.getByRole('button',{name:'Advance fixture',exact:true}).click();await page.getByText('AI review complete',{exact:true}).waitFor();assert.equal((await page.evaluate(()=>(window as any).calls)).length,0);assert.deepEqual(errors,[]);console.log('PASS: correction → recheck → founder review status; no automatic approval or provider calls');}finally{await browser.close();}
