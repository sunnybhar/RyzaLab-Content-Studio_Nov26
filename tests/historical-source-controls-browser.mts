import{build}from'esbuild';import{chromium}from'playwright';import assert from'node:assert/strict';import{initialState,DEMO_ACTOR,EMPTY_MEDIA}from'../lib/studio/seed';import{applyCommand}from'../lib/studio/engine';import{copyIdentity}from'../lib/studio/solo-quality';
const wiki='https://en.wikipedia.org/wiki/Home_automation';let fixture=initialState(DEMO_ACTOR,true);fixture=applyCommand(fixture,DEMO_ACTOR,{type:'policy.adoptSolo',expectedRuleVersion:fixture.settings.protectedVersion,packageCap:50,monthlyCap:500,requireIndependentReview:false,autoDraft:false,autoReview:true,autoCorrect:false},{demo:true});fixture.contents=fixture.contents.slice(0,1);fixture.packages=[];const content=fixture.contents[0];content.state='review';content.format='Text post';content.text='A useful handoff can document household routines.';content.metadata='';content.media=structuredClone(EMPTY_MEDIA);content.copyAcceptances=[];content.researchJobIds=['historical-research'];content.reviewSubmission={id:'root',actor:DEMO_ACTOR.email,identity:copyIdentity(content,fixture),at:new Date().toISOString()};content.agentReview={jobId:'historical-review',identity:copyIdentity(content,fixture),provider:'openai',model:'fixture',independent:false,at:new Date().toISOString(),summary:'Original report retained.',issues:[],context:'provided_references'};fixture.jobs=[{id:'historical-research',kind:'research',channel:content.channel,createdBy:DEMO_ACTOR.email,createdAt:new Date().toISOString(),state:'succeeded',prompt:'An old reference result',estimate:0,result:JSON.stringify({version:1,summary:'Historical source evidence.',citations:[{url:wiki,title:'Old encyclopedia entry',citedText:'Historical passage retained in the original result.'}],claims:[],searchesObserved:1,stopReason:'end_turn',errors:[],status:'cited_research',notice:'Historical provenance only.'})},{id:'historical-review',kind:'review',channel:content.channel,contentId:content.id,createdBy:DEMO_ACTOR.email,state:'succeeded',prompt:JSON.stringify({webEvidence:[{citations:[{url:wiki}]}]})}]as any;
const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{ResearchPanel}from'./components/research-panel';import{SoloReview}from'./components/solo-review';const state=${JSON.stringify(fixture)},actor=${JSON.stringify(DEMO_ACTOR)};window.calls=[];function App(){const[selected,setSelected]=useState(['historical-research']);return <><ResearchPanel state={state} actor={actor} channel={state.contents[0].channel} selected={selected} onSelected={setSelected} run={async c=>{window.calls.push(c);return true;}} refresh={async()=>{}} demo={true}/><output>Selected: {selected.length}</output><SoloReview state={state} content={state.contents[0]} actor={actor} send={async c=>{window.calls.push(c)}} renderAsset={()=>null} requestChanges={()=>{}} openDraft={()=>{}} recordPriceException={()=>{}} refresh={async()=>{}} demo={true}/></>};createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,loader:{'.css':'empty'},format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true,args:['--no-sandbox']});try{const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('http://localhost:31344/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31344/');const panel=page.getByRole('region',{name:'Web research',exact:true});assert.equal(await panel.getByRole('checkbox').count(),0);await panel.getByRole('button',{name:'Remove excluded selection',exact:true}).click();await page.getByText('Selected: 0',{exact:true}).waitFor();await panel.getByText('Excluded historical sources — not used in new AI work',{exact:true}).click();await panel.getByText('Historical passage retained in the original result.',{exact:true}).waitFor();assert.equal((await page.evaluate(()=>(window as any).calls)).length,0);await page.getByRole('button',{name:'Request fresh review within package allowance',exact:true}).click();const calls=await page.evaluate(()=>(window as any).calls);assert.equal(calls.length,1);assert.equal(calls[0].type,'content.generate');assert.equal(calls[0].kind,'review');assert.deepEqual(calls[0].researchJobIds,[]);assert.deepEqual(errors,[]);console.log('PASS: excluded historical evidence stays readable but unselectable, removal is visible, and fresh review is explicit and uses only allowed selected evidence; no network/provider calls');}finally{await browser.close();}
