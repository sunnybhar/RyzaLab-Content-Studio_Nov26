import {build} from 'esbuild';import {chromium} from 'playwright';import assert from 'node:assert/strict';import {initialState,DEMO_ACTOR} from '../lib/studio/seed';
const state=initialState(DEMO_ACTOR,true);state.ideas=[];const card={title:'Review household data flows',brief:'A source-led question about controls and limitations.',audience:'Households',format:'LinkedIn text post',sources:['Supplied context — privacy section']};
state.jobs=[{id:'cut-off',kind:'ideas',channel:'LinkedIn',prompt:JSON.stringify({quantity:3}),connectionId:'fixture',estimate:14,reserved:0,actual:7,state:'succeeded',attempt:1,idempotencyKey:'original',createdBy:DEMO_ACTOR.email,createdAt:new Date().toISOString(),providerCompletion:'incomplete',providerStopReason:'max_tokens',providerUsage:{inputTokens:20882,outputTokens:2048,cacheReadTokens:0,cacheCreationTokens:0},error:'Idea generation was incomplete. The raw response is retained; no incomplete batch was imported.',result:'[INCOMPLETE OUTPUT — token limit reached; not ready for approval]\n{"ideas":['+JSON.stringify(card)+','+JSON.stringify({...card,title:'Document account recovery'})+',{ "title":"Unfinished last card'}];
const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{IdeaGenerationStatus}from'./components/idea-generation-status';import{applyCommand}from'./lib/studio/engine';const actor=${JSON.stringify(DEMO_ACTOR)};window.commands=[];function App(){const[state,setState]=useState(${JSON.stringify(state)});window.saved=state;return <IdeaGenerationStatus state={state} actor={actor} channel="All channels" live={false} refresh={async()=>{}} send={async c=>{window.commands.push(c);setState(applyCommand(state,actor,c,{demo:true}));}}/>}createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true,args:['--no-sandbox']});try{const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('http://localhost:31345/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31345/');await page.getByText(/2,048 output tokens/).waitFor();assert.equal(await page.getByRole('button',{name:'Import saved ideas — no AI call',exact:true}).count(),0);await page.getByText('View saved provider response',{exact:true}).click();await page.getByRole('button',{name:'Recover 2 complete saved ideas — no AI call',exact:true}).click();await page.getByText('2 of 3 requested ideas imported — needs attention',{exact:false}).waitFor();const saved=await page.evaluate(()=>(window as any).saved);assert.equal(saved.ideas.length,2);assert.ok(saved.ideas.every((i:any)=>i.state==='pending'));assert.equal(saved.jobs[0].actual,7);assert.equal(saved.jobs[0].reserved,0);assert.equal(saved.jobs[0].result,state.jobs[0].result);assert.deepEqual((await page.evaluate(()=>(window as any).commands)).map((c:any)=>c.type),['idea.recoverCompleteCards']);assert.deepEqual(errors,[]);console.log('PASS: token-limit diagnosis, raw response access, no impossible full-batch import, explicit complete-card recovery and unchanged charge with no AI calls');}finally{await browser.close();}
