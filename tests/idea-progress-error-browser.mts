import {build} from 'esbuild';import {chromium} from 'playwright';import assert from 'node:assert/strict';
const message='This request exceeds the qualified input limit. Shorten the brief or selected reference set.';
const script=await build({stdin:{contents:`import React from 'react';import {createRoot} from 'react-dom/client';import {IdeaRunProgress} from './components/idea-run-progress';createRoot(document.getElementById('app')).render(<IdeaRunProgress job={window.fixtureJob} busy={false} startedAt={Date.now()} sourceCount={0} readyCount={0} targetCount={1} syncError="" requestError=${JSON.stringify(message)} refresh={async()=>{}} confirm={async()=>{}}/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true,args:['--no-sandbox']});
try{const page=await browser.newPage();await page.route('http://localhost:31344/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31344/');const progress=page.getByRole('region',{name:'Research and idea progress'});await progress.getByRole('alert').getByText(message,{exact:true}).waitFor();assert.equal(await progress.getByText('In progress',{exact:true}).count(),0);await progress.getByText('Status unavailable — see error',{exact:true}).waitFor();await progress.getByText('No result — see error',{exact:true}).waitFor();assert.equal(await progress.getByRole('button').count(),0);await page.addInitScript(()=>{(window as any).fixtureJob={id:'waiting',state:'awaiting_confirmation',kind:'ideas',estimate:14};});await page.reload();await progress.getByText('Not started — waiting for approval',{exact:true}).waitFor();assert.equal(await progress.getByText('Stopped — inspect saved request',{exact:true}).count(),0);await progress.getByRole('button',{name:'Approve up to $0.14',exact:true}).waitFor();const display=await progress.getByRole('alert').evaluate(el=>getComputedStyle(el).display);assert.equal(display,'block');console.log('PASS: failed initial request shows the actual error in the visible progress panel with truthful stages and no retry');}finally{await browser.close();}
