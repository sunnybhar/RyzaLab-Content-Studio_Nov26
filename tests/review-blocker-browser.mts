import {build} from 'esbuild';import {chromium} from 'playwright';import assert from 'node:assert/strict';import {initialState,DEMO_ACTOR,EMPTY_MEDIA} from '../lib/studio/seed';import {applyCommand} from '../lib/studio/engine';
let fixture=initialState(DEMO_ACTOR,true);fixture=applyCommand(fixture,DEMO_ACTOR,{type:'policy.adoptSolo',expectedRuleVersion:fixture.settings.protectedVersion,packageCap:50,monthlyCap:500,requireIndependentReview:false,autoDraft:false,autoReview:true},{demo:true});const content=fixture.contents[0];content.state='review';content.text='A household handoff can document routines and useful contacts.';content.metadata='';content.media=structuredClone(EMPTY_MEDIA);content.format='Text post';const workflow=fixture.workflows.find(w=>w.channel===content.channel&&w.status==='active')!;
fixture=applyCommand(fixture,DEMO_ACTOR,{type:'content.acceptCopy',contentId:content.id,expectedRevision:content.revision,expectedWorkflowId:workflow.id,expectedRuleVersion:fixture.settings.protectedVersion,expectedPolicyVersion:fixture.settings.reviewPolicy!.version,evidence:'Reviewed the current copy and source evidence.'},{demo:true});
const job={id:'missing-writing',kind:'text',contentId:content.id,channel:content.channel,account:content.account,connectionId:'fixture',prompt:'Existing request',estimate:14,reserved:14,state:'unknown',attempt:1,idempotencyKey:'existing',createdBy:DEMO_ACTOR.email,createdAt:new Date().toISOString(),dispatchStartedAt:new Date().toISOString(),leaseUntil:new Date(Date.now()+180000).toISOString(),targetRevision:content.revision};fixture.jobs=[job as any];
const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{SoloReview}from'./components/solo-review';import{applyCommand}from'./lib/studio/engine';const actor=${JSON.stringify(DEMO_ACTOR)},baseJob=${JSON.stringify(job)};window.commands=[];window.progress=[];function App(){const[state,setState]=useState(${JSON.stringify(fixture)});window.saved=state;return <><button onClick={()=>setState(s=>({...s,jobs:[{...baseJob,id:'saved-review',kind:'review',state:'queued'}]}))}>Load queued review fixture</button><button onClick={()=>setState(s=>({...s,jobs:[{...baseJob,id:'confirm-review',kind:'review',state:'awaiting_confirmation'}]}))}>Load confirmation fixture</button><SoloReview content={state.contents[0]} state={state} actor={actor} demo={false} refresh={async()=>{}} progressJob={async id=>{window.progress.push(id)}} send={async c=>{window.commands.push(c);if(c.type==='job.reconcile')setState(applyCommand(state,actor,c,{demo:true}));return {state};}} renderAsset={()=>null} openDraft={()=>{}} recordPriceException={()=>{}} requestChanges={()=>{}}/></>};createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,loader:{'.css':'empty'},format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true,args:['--no-sandbox']});try{const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('http://localhost:31346/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31346/');await page.getByText('Writing · Outcome uncertain',{exact:true}).waitFor();await page.getByText(/Dispatch started:/).waitFor();assert.equal(await page.getByRole('button',{name:'Request textual review',exact:true}).isDisabled(),true);assert.equal(await page.getByRole('button',{name:/Cancel undispatched/}).count(),0);await page.getByText('Record verified provider outcome',{exact:true}).click();const save=page.getByRole('button',{name:'Save verified outcome — no AI call',exact:true});assert.equal(await save.isDisabled(),true);await page.getByLabel('Verified provider outcome',{exact:true}).selectOption('failed');await page.getByLabel('Verified provider cost',{exact:true}).fill('0.07');await page.getByLabel('Provider outcome evidence',{exact:true}).fill('Verified provider fixture request failed; actual cost confirmed.');await save.click();await page.getByText(/No current review request is visible/).waitFor();assert.equal(await page.getByRole('button',{name:'Request textual review',exact:true}).isEnabled(),true);await page.getByLabel(/I reviewed the exact copy and all included media/).check();assert.equal(await page.getByRole('button',{name:'Approve final package',exact:true}).isDisabled(),true);const saved=await page.evaluate(()=>(window as any).saved);assert.equal(saved.jobs[0].actual,7);assert.equal(saved.jobs[0].reserved,0);assert.equal(saved.contents[0].agentReview,undefined);assert.equal(saved.packages.length,0);
await page.getByRole('button',{name:'Load queued review fixture',exact:true}).click();await page.getByRole('button',{name:'Run saved textual review request',exact:true}).click();assert.deepEqual(await page.evaluate(()=>(window as any).progress),['saved-review']);await page.getByRole('button',{name:'Load confirmation fixture',exact:true}).click();await page.getByRole('button',{name:/Confirm saved textual review allowance/}).click();assert.deepEqual((await page.evaluate(()=>(window as any).commands)).map((c:any)=>c.type),['job.reconcile','job.confirm']);assert.deepEqual(errors,[]);console.log('PASS: exact hidden writing blocker shown, verified resolution does not bypass report/approval, queued review uses existing ID, confirmation creates no duplicate jobs');}finally{await browser.close();}
