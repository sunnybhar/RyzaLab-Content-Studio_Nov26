import {build} from "esbuild";
import {chromium} from "playwright";
import assert from "node:assert/strict";
import {initialState,DEMO_ACTOR,EMPTY_MEDIA} from "../lib/studio/seed";
const fixture=initialState(DEMO_ACTOR,true);fixture.packages=Array.from({length:13},(_,i)=>({id:`pkg${i}`,contentId:"draft",channel:i%2?"LinkedIn":"Newsletter",account:"RyzaLab",title:`History item ${i}`,format:i%2?"Blog":"Newsletter",revision:1,text:`Exact approved snapshot ${i}`,metadata:"",media:structuredClone(EMPTY_MEDIA),ruleVersion:"test",approvedBy:DEMO_ACTOR.email,approvedAt:new Date().toISOString(),hash:`hash${i}`}));fixture.schedules=fixture.packages.slice(0,12).map((p,i)=>({id:`schedule${i}`,contentId:"draft",packageId:p.id,at:new Date().toISOString(),owner:DEMO_ACTOR.email,state:"published",publicationUrl:`https://example.org/${i}`,confirmedAt:new Date(Date.now()-i*86400000).toISOString(),confirmedBy:DEMO_ACTOR.email}));
const script=await build({stdin:{resolveDir:process.cwd(),loader:"tsx",contents:`import React from'react';import{createRoot}from'react-dom/client';import{ReviewHistory}from'./components/review-history';const state=${JSON.stringify(fixture)};createRoot(document.getElementById('app')).render(<ReviewHistory state={state} AssetMedia={()=>null} onPlan={()=>{}} onExport={()=>{}}/>);`},bundle:true,write:false,format:"iife",jsx:"automatic",loader:{".css":"empty"},define:{"process.env.NODE_ENV":'"production"'}});
const browser=await chromium.launch({executablePath:"/usr/bin/chromium",args:["--no-sandbox"]});try{const page=await browser.newPage();await page.route('http://localhost:31348/**',r=>r.fulfill({contentType:"text/html",body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31348/');await page.getByRole('heading',{name:'Approved & Published'}).waitFor();assert.equal(await page.getByRole('button',{name:'Preview',exact:true}).count(),10);await page.getByLabel('Published in',{exact:true}).selectOption('1');assert.equal(await page.getByRole('button',{name:'Preview',exact:true}).count(),12);await page.getByRole('button',{name:'Preview',exact:true}).first().click();const dialog=page.getByRole('dialog',{name:'Saved content preview'});await dialog.getByText('Exact approved snapshot 0',{exact:true}).waitFor();await dialog.getByRole('button',{name:'Close preview'}).click();assert.equal(await page.getByLabel('Published in',{exact:true}).inputValue(),'1');await page.getByLabel('Status',{exact:true}).selectOption('approved');assert.equal(await page.getByRole('button',{name:'Preview',exact:true}).count(),1);await page.setViewportSize({width:390,height:844});assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2));console.log('PASS: last10 actual publications, full month history, correct immutable popup, preserved filter, separate approvals and mobile');}finally{await browser.close();}
