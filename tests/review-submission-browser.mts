import {chromium} from "playwright";
import assert from "node:assert/strict";
import {initialState,DEMO_ACTOR,EMPTY_MEDIA} from "../lib/studio/seed";
import {applyCommand} from "../lib/studio/engine";
const browser=await chromium.launch({executablePath:"/usr/bin/chromium",args:["--no-sandbox"]});
try{for(const valid of [true,false]){let state=initialState(DEMO_ACTOR,true);state=applyCommand(state,DEMO_ACTOR,{type:"policy.adoptSolo",expectedRuleVersion:state.settings.protectedVersion,packageCap:50,monthlyCap:500,requireIndependentReview:false,autoDraft:false,autoReview:false},{demo:true});const draft=state.contents[0];draft.title="Submission completion browser";draft.channel="LinkedIn";draft.format="Text post";draft.text=valid?"A practical handoff can document routines and useful contacts.":"";draft.metadata="";draft.media=structuredClone(EMPTY_MEDIA);draft.state="draft";state.contents=[draft];state.jobs=[];const context=await browser.newContext({viewport:{width:1440,height:1100}});const page=await context.newPage();await page.addInitScript(s=>localStorage.setItem('ryzalab-studio-v2',JSON.stringify(s)),state);await page.goto((process.env.TEST_BASE_URL||"http://localhost:3015")+"/preview");await page.locator('.s-sidebar nav').getByText('Create',{exact:true}).click();await page.getByRole('button',{name:`Open ${draft.title}`,exact:true}).click();await page.getByRole('button',{name:'Submit for review',exact:true}).click();if(valid){await page.getByRole('heading',{name:'Your workbench',exact:true}).waitFor();await page.getByRole('button',{name:'View in Reviews',exact:true}).waitFor();assert.equal(await page.evaluate(()=>JSON.parse(localStorage.getItem('ryzalab-studio-v2')!).contents[0].state),'review');}else{await page.getByText('Add content before submitting.',{exact:false}).waitFor();assert.equal(await page.getByLabel('Content text',{exact:true}).isVisible(),true);assert.equal(await page.evaluate(()=>JSON.parse(localStorage.getItem('ryzalab-studio-v2')!).contents[0].state),'draft');}await context.close();}console.log('PASS: confirmed submission closes editor to Create with Reviews action; failed submission stays in editor without a false under-review state');}finally{await browser.close();}
