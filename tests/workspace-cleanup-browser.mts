import {chromium} from "playwright";import assert from "node:assert/strict";
import {initialState,DEMO_ACTOR} from "../lib/studio/seed";
const state=initialState(DEMO_ACTOR,true),now="2026-11-03T15:30:00Z";
const jobId="a32f810c-1234-4444-9999-123456789012";
state.jobs.push({id:jobId,kind:"ideas",channel:"LinkedIn",createdAt:now,createdBy:DEMO_ACTOR.email,state:"succeeded",actual:6,reserved:0,estimate:14,prompt:JSON.stringify({topic:"Original privacy topic for families",quantity:1}),connectionId:"fixture",attempt:1,idempotencyKey:"fixture",result:'{"ideas":[]}'},{id:"retired",channel:"TikTok",kind:"ideas",actual:17,reserved:0,createdAt:now,state:"succeeded"} as any);
state.ideas.unshift({...state.ideas[0],id:"generated",title:"Generated idea metadata check",generationRunId:jobId,origin:"agent",createdAt:now});
const browser=await chromium.launch({executablePath:"/usr/bin/chromium",headless:true,args:["--no-sandbox"]});
try{const page=await browser.newPage({viewport:{width:1440,height:1050}});const errors:string[]=[];page.on("pageerror",e=>errors.push(e.message));await page.addInitScript(state=>localStorage.setItem("ryzalab-studio-v2",JSON.stringify(state)),state);
