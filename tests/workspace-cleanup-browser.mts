await page.locator(".s-topbar").getByText("RyzaLab Content Studio",{exact:true}).waitFor();assert.equal(await page.locator(".s-topbar").getByRole("button",{name:/Command Center|Production Board|Appearance|What’s new/}).count(),0);await page.locator(".s-sidebar-tools").getByRole("button",{name:"Command Center",exact:true}).waitFor();
await page.locator(".s-sidebar nav").getByRole("button",{name:"Ideas",exact:true}).click();const channels=(await page.locator(".s-channel-tabs").textContent())!;for(const label of ["TikTok","Facebook","Notes","Hub"])assert.equal(channels.includes(label),false);
const status=page.getByRole("region",{name:"Idea generation status"});await status.getByText("IDEA-A32F810C",{exact:true}).waitFor();await status.getByText("Original privacy topic for families",{exact:false}).waitFor();assert.equal(await page.getByText("View saved provider response",{exact:true}).count(),0);await page.getByRole("link",{name:"Compare 4 Ideas layouts",exact:true}).waitFor();await page.screenshot({path:"/tmp/ryza-0325-ideas.png",fullPage:true});
await page.locator(".s-sidebar nav").getByRole("button",{name:"Create",exact:true}).click();await page.getByText(state.contents[0].title,{exact:true}).first().click();await page.getByText("More options",{exact:true}).waitFor();assert.equal(await page.locator(".s-editor-options").getAttribute("open"),null);assert.equal(await page.getByRole("button",{name:"Complete project JSON",exact:false}).isVisible(),false);
await page.goto(base+"/ideas-layouts");for(let index=0;index<4;index++){const options=page.getByRole("navigation",{name:"Layout options"}).getByRole("button");await options.nth(index).click();assert.equal(await options.nth(index).getAttribute("aria-pressed"),"true");await page.screenshot({path:`/tmp/ryza-ideas-layout-${index+1}.png`,fullPage:true});}
await page.getByRole("button",{name:"Shortlist →",exact:true}).first().click();assert.ok(await page.locator(".il-board>section").nth(1).getByRole("article").count());await page.setViewportSize({width:390,height:844});assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));assert.deepEqual(errors,[]);console.log("PASS: product header, relocated controls, retired channel views, original request metadata, no raw response, collapsed editor tools, four interactive layouts and mobile preview");
}finally{await browser.close();}
