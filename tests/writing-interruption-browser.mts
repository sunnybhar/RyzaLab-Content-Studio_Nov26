const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{DraftAssistant}from'./components/draft-assistant';import{applyCommand}from'./lib/studio/engine';import{generationInput}from'./lib/studio/generation';import{settleWrittenOutput}from'./lib/studio/draft-candidates';const actor=${JSON.stringify(DEMO_ACTOR)};window.commands=[];window.recoveries=[];function App(){const[state,setState]=useState(${JSON.stringify(fixture)});window.saved=state;window.finish=()=>setState(s=>{const next=structuredClone(s),job=next.jobs[0];job.state='succeeded';job.actual=7;job.reserved=0;settleWrittenOutput(next,job,{completion:'complete',text:JSON.stringify({body:'A recovered writing workflow now produces a usable LinkedIn draft.',metadata:'',sources:[],questions:[]})},new Date().toISOString());return next;});return <><DraftAssistant content={state.contents[0]} state={state} actor={actor} demo={false} dirty={false} readOnly={false} busy={false} refresh={async()=>{}} recoverJob={async id=>{window.recoveries.push(id);return{recovered:false};}} run={async command=>{window.commands.push(command);const input=command.type==='content.generate'?generationInput(state,actor,command):command;setState(applyCommand(state,actor,input,{demo:true,canonicalGeneration:true}));return true;}}/><textarea aria-label='Content text' value={state.contents[0].text} readOnly/></>};createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:"tsx"},bundle:true,write:false,loader:{".css":"empty"},format:"iife",jsx:"automatic",define:{"process.env.NODE_ENV":'"production"'}});
const browser=await chromium.launch({executablePath:"/usr/bin/chromium",headless:true,args:["--no-sandbox"]});try{const page=await browser.newPage();const errors:string[]=[];page.on("pageerror",e=>errors.push(e.message));await page.route("http://localhost:31348/**",r=>r.fulfill({contentType:"text/html",body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll("</script","<\\/script")+'</script>'}));await page.goto("http://localhost:31348/");const followup=page.getByRole("button",{name:"Start a new writing attempt",exact:true});await followup.waitFor();await page.waitForFunction(()=>(window as any).recoveries.length===1);assert.deepEqual(await page.evaluate(()=>(window as any).commands),[]);assert.equal(await page.getByRole("button",{name:"Write with AI",exact:true}).isDisabled(),true);await followup.click();await page.getByText("Writing request is waiting to start.",{exact:true}).waitFor();let state=await page.evaluate(()=>(window as any).saved);assert.equal(state.jobs.length,2);assert.equal(state.jobs[1].state,"unknown");assert.equal(state.jobs[1].reserved,14);assert.equal(state.jobs[0].reserved,14);assert.deepEqual((await page.evaluate(()=>(window as any).commands))[0].acknowledgeUnknownJobIds,["old-unknown"]);await page.evaluate(()=>(window as any).finish());await page.getByRole("button",{name:"Revise with AI",exact:true}).waitFor();assert.equal(await page.getByRole("button",{name:"Revise with AI",exact:true}).isEnabled(),true);assert.match(await page.getByLabel("Content text",{exact:true}).inputValue(),/usable LinkedIn draft/);state=await page.evaluate(()=>(window as any).saved);assert.equal(state.jobs[1].reserved,14);assert.equal(state.jobs[1].actual,undefined);assert.deepEqual(await page.evaluate(()=>(window as any).recoveries),["old-unknown"]);assert.equal((await page.evaluate(()=>(window as any).commands)).length,1);assert.deepEqual(errors,[]);console.log("PASS: unknown writing checks saved receipt without AI call, explicit follow-up retains old hold, completes into editor and does not remain blocked by old unknown");}finally{await browser.close();}
