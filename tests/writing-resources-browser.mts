import {build} from 'esbuild';
import {chromium} from 'playwright';
import assert from 'node:assert/strict';
import {initialState,DEMO_ACTOR} from '../lib/studio/seed';
const fixture=initialState(DEMO_ACTOR,true);
const script=await build({stdin:{contents:`import React,{useState}from'react';import{createRoot}from'react-dom/client';import{WritingResources}from'./components/writing-resources';import{applyCommand}from'./lib/studio/engine';const actor=${JSON.stringify(DEMO_ACTOR)};function App(){const[state,setState]=useState(${JSON.stringify(fixture)});async function send(c){const next=applyCommand(state,actor,c);setState(next);return {state:next};}return <WritingResources state={state} channel="LinkedIn" send={send} allowed={true}/>};createRoot(document.getElementById('app')).render(<App/>);`,resolveDir:process.cwd(),loader:'tsx'},bundle:true,write:false,format:'iife',jsx:'automatic',define:{'process.env.NODE_ENV':'"production"'}});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox'],headless:true});
try{const page=await browser.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.route('http://localhost:31339/**',r=>r.fulfill({contentType:'text/html',body:'<div id="app"></div><script>'+script.outputFiles[0].text.replaceAll('</script','<\\/script')+'</script>'}));await page.goto('http://localhost:31339/');
const resource=page.locator('details').filter({has:page.locator('summary',{hasText:'Ryan’s Humanizer'})}).first();await resource.locator('summary').first().click();await resource.getByRole('button',{name:'Edit guidance',exact:true}).click();await resource.getByRole('textbox').fill('Keep writing concrete. Do not invent personal experiences.');await resource.getByRole('button',{name:'Save guidance',exact:true}).click();await resource.locator('summary').first().filter({hasText:'Saved'}).waitFor();await resource.getByRole('button',{name:'Edit guidance',exact:true}).click();await resource.getByRole('textbox').fill('Use clear sentences. Do not invent personal experiences.');await resource.getByRole('button',{name:'Save guidance',exact:true}).click();await resource.getByText('Previous versions',{exact:true}).click();assert.equal(await resource.getByRole('button',{name:'Download version',exact:true}).count(),1);assert.deepEqual(errors,[]);console.log('PASS: resource guidance saves, revisions retain original download, no page errors; local fixture only');}finally{await browser.close();}
